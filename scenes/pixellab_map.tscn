metadata/pixellab_source = "{\"id\":\"72ca9de2-36d6-41e6-9a9d-167264a8cec6\",\"name\":\"Superfícies jogáveis\",\"geometryType\":\"rectArea\",\"visible\":true,\"locked\":false,\"color\":\"#ffd93d\",\"tags\":[],\"defaultProperties\":{},\"terrainSource\":{\"terrainIds\":[1,2,3,5,6,7,9],\"terrainNames\":[\"thin weathered stone ledge capping the platform with chipped block edges and gentle moss overgrowth, featuring soft highlights and shadows for moderate depth\",\"thin shallow surface rim of dark moss, dead grass blades, twisted root fibers, sparse pale fungi, and small thorny growths over the stone in desaturated greens with gentle depth and soft shadows\",\"thin mossy forest stone top surface strip scattered with dead weeds and twig fragments, featuring soft medium depth shading and natural woodland weathering\",\"thin platform surface strip with short overgrown grass, small protruding roots, and a weathered stone lip, featuring soft medium depth lighting\",\"dark gothic forest floor capping the platform edge with weathered grey stone slabs and damp moss, featuring soft highlights and moderate atmospheric depth\",\"thin low surface strip of cracked planks, decayed support beams, damp moss, and subtle rope details in a dark forgotten forest atmosphere with moderate depth and soft lighting\",\"narrow uneven platform top covered in mossy overgrowth and cracked stone fragments with moderate depth and soft shadows\"]},\"rects\":[{\"id\":\"72ca9de2-36d6-41e6-9a9d-167264a8cec6-mask-0\",\"x\":304,\"y\":688,\"width\":160,\"height\":32},{\"id\":\"72ca9de2-36d6-41e6-9a9d-167264a8cec6-mask-1\",\"x\":880,\"y\":688,\"width\":96,\"height\":32},{\"id\":\"72ca9de2-36d6-41e6-9a9d-167264a8cec6-mask-2\",\"x\":1584,\"y\":688,\"width\":96,\"height\":32},{\"id\":\"72ca9de2-36d6-41e6-9a9d-167264a8cec6-mask-3\",\"x\":16,\"y\":784,\"width\":576,\"height\":160},{\"id\":\"72ca9de2-36d6-41e6-9a9d-167264a8cec6-mask-4\",\"x\":752,\"y\":784,\"width\":480,\"height\":160},{\"id\":\"72ca9de2-36d6-41e6